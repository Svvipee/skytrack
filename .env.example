# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-in-production

# OAuth Providers (optional - app works without these)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# OpenSky Network OAuth2 (optional - anonymous access is supported)
OPENSKY_CLIENT_ID=your-opensky-client-id
OPENSKY_CLIENT_SECRET=your-opensky-client-secret

# AviationStack API (optional - enriches flight metadata)
AVIATIONSTACK_API_KEY=your-aviationstack-key

# AeroDataBox API via RapidAPI (optional - aircraft/airport enrichment)
AERODATABOX_API_KEY=your-aerodatabox-rapidapi-key
